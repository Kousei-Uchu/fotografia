# Google Drive API
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GOOGLE_DRIVE_MASTER_FOLDER_ID=your_master_folder_id_here

# NextAuth (Admin Authentication)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (hashed password recommended in production)
ADMIN_EMAIL=admin@yoursite.com
ADMIN_PASSWORD=your-secure-password

# App
NEXT_PUBLIC_SITE_NAME="Your Name"
NEXT_PUBLIC_SITE_TAGLINE="Photography"
